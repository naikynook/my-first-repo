{
  "rules": {
    ".read": false,
    ".write": false,
    "survey": {
      "frt": {
        ".read": true,
        "$question": {
          ".validate": "$question.matches(/^q[1-5]$/)",
          "yes": {
            ".write": true,
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
          },
          "no": {
            ".write": true,
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chat": {
      "messages": {
        ".read": true,
        "$messageId": {
          ".write": true,
          ".validate": "newData.hasChildren(['text', 'sender', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 8000 && (newData.child('sender').val() === 'user' || newData.child('sender').val() === 'bot') && newData.child('timestamp').isNumber()"
        }
      },
      "rateLimits": {
        ".read": false,
        ".write": false
      }
    }
  }
}
