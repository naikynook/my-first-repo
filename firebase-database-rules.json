{
  "rules": {
    ".read": false,
    ".write": false,
    "survey": {
      "frt": {
        ".read": true,
        "$question": {
          ".validate": "$question.matches(/^q[1-5]$/)",
          "yes": {
            ".write": true,
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
          },
          "no": {
            ".write": true,
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chat": {
      "messages": {
        ".read": true,
        ".write": true,
        "$messageId": {
          ".validate": "newData.hasChildren(['text', 'sender', 'timestamp'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8000"
          },
          "sender": {
            ".validate": "newData.val() === 'user' || newData.val() === 'bot'"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rateLimits": {
        ".read": false,
        ".write": false
      }
    }
  }
}
